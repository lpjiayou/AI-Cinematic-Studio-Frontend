# Server-only Creator Experience Adapter configuration.
# Never expose these values through NEXT_PUBLIC_* variables.
CREATOR_CORE_BASE_URL=http://127.0.0.1:8765
# Required. Use a high-entropy runtime secret; never commit a real token.
CREATOR_CORE_TOKEN=replace-with-high-entropy-runtime-secret
CREATOR_CONTENT_PROFILE_REF=content-profile-local-creator
